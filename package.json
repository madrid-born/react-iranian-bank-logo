{
  "name": "react-iranian-bank-logo",
  "version": "1.1.1",
  "description": "Iranian bank logos and icons as React components for React and Next.js applications.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node scripts/build-icons.js && node scripts/generate-types.js",
    "build": "babel src --out-dir dist --extensions .js,.jsx && cp index.d.ts dist/index.d.ts && npm run copy-icons",
    "copy-icons": "copyfiles -u 2 src/icons/*.svg dist/icons",
    "dev": "npm run build -- --watch"
  },
  "keywords": [
    "react",
    "react-components",
    "react-icons",
    "bank",
    "bank-logos",
    "bank-icons",
    "iranian-banks",
    "iran-banks",
    "iranian-bank",
    "iran-bank",
    "iran",
    "iranian",
    "logos",
    "icons",
    "svg",
    "nextjs",
    "next-js",
    "persian",
    "لوگو بانک"
  ],
  "author": "CyberHuginn",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0"
  },
  "dependencies": {
    "copyfiles": "^2.4.1"
  }
}